---
// Orbite bleue et grise reprise du logo historique, mot-symbole du pied de page.
---

<span class="logo">
  <svg
    class="logo-mark"
    viewBox="0 0 48 48"
    width="40"
    height="40"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M10.5 37.5A19 19 0 0 1 37.5 10.5"
      fill="none"
      stroke="currentColor"
      stroke-opacity=".38"
      stroke-width="3.2"
      stroke-linecap="round"
    ></path>
    <path
      d="M41.6 17.2A19.5 19.5 0 0 1 17.2 41.6"
      fill="none"
      stroke="#0686ce"
      stroke-width="4.4"
      stroke-linecap="round"
    ></path>
    <circle cx="24" cy="24" r="4.2" fill="#0686ce"></circle>
  </svg>
  <span class="logo-word">
    aimy digital<span class="logo-dot">.</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
  }
  .logo-mark {
    flex: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .logo-word {
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-dot {
    color: #0686ce;
  }
  :global(a:hover) > .logo .logo-mark {
    transform: rotate(-24deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-mark {
      transition: none;
    }
  }
</style>
