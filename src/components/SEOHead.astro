---
import { site } from "../lib/site";
import { company } from "../lib/company";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  article?: { date: string; modified: string };
  faq?: readonly { question: string; answer: string }[];
}
const {
  title,
  description,
  noindex = false,
  image = "/images/og-default.jpg",
  article,
  faq,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const hidden = noindex || import.meta.env.PUBLIC_SITE_ENV !== "production";
const orgId = `${site.url}/#organisation`;
const city = (name: string, region: string) => ({
  "@type": "City",
  name,
  containedInPlace: { "@type": "AdministrativeArea", name: region },
});
const organization = {
  "@type": "ProfessionalService",
  "@id": orgId,
  name: site.name,
  legalName: company.legalName,
  description:
    "Agence web à Saint-Amand-sur-Sèvre : création de sites internet, référencement SEO local et publicité pour les entreprises du Bocage.",
  url: site.url,
  logo: new URL("/favicon.svg", site.url).href,
  image: new URL("/images/og-default.jpg", site.url).href,
  email: site.email,
  telephone: site.tel,
  vatID: company.vat,
  identifier: [
    { "@type": "PropertyValue", propertyID: "SIREN", value: company.siren },
    { "@type": "PropertyValue", propertyID: "SIRET", value: company.siret },
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: company.street,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressRegion: "Deux-Sèvres",
    addressCountry: "FR",
  },
  areaServed: [
    city("Mauléon", "Deux-Sèvres"),
    city("Bressuire", "Deux-Sèvres"),
    city("Cholet", "Maine-et-Loire"),
    city("Les Herbiers", "Vendée"),
  ],
  founder: {
    "@type": "Person",
    name: "Mehdi Farhane",
    jobTitle: "Fondateur",
    image: new URL("/images/team/mehdi-farhane.webp", site.url).href,
    sameAs: ["https://fr.linkedin.com/in/mehdi-farhane"],
  },
  sameAs: ["https://www.threads.com/@aimy_digital"],
  knowsAbout: [
    "Création de sites internet",
    "Référencement local",
    "Google Ads",
    "Maintenance WordPress",
  ],
};
// Fil d'Ariane déduit du chemin ; le dernier élément reprend le titre de la page.
const labels: Record<string, string> = {
  portfolio: "Réalisations",
  "creation-de-sites-internet": "Création de sites internet",
  category: "Journal",
  blog: "Journal",
};
const segments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumb =
  segments.length > 0
    ? {
        "@type": "BreadcrumbList",
        itemListElement: [
          { name: "Accueil", path: "/" },
          ...segments.map((seg, i) => ({
            name:
              i === segments.length - 1
                ? title
                : (labels[seg] ?? seg.replace(/-/g, " ")),
            path: "/" + segments.slice(0, i + 1).join("/") + "/",
          })),
        ]
          .filter((item) => item.path !== "/category/")
          .map((item, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: item.name,
            item: new URL(item.path, site.url).href,
          })),
      }
    : null;
const page = article
  ? {
      "@type": "Article",
      headline: title,
      image: new URL(image, site.url).href,
      datePublished: article.date,
      dateModified: article.modified,
      mainEntityOfPage: canonical,
      author: { "@id": orgId },
      publisher: { "@id": orgId },
    }
  : {
      "@type": "WebPage",
      "@id": canonical,
      name: title,
      description,
      isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
      about: { "@id": orgId },
    };
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    page,
    ...(breadcrumb ? [breadcrumb] : []),
    ...(faq?.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: faq.map((q) => ({
              "@type": "Question",
              name: q.question,
              acceptedAnswer: { "@type": "Answer", text: q.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | Aimy Digital</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={hidden ? "noindex, nofollow" : "index, follow"} />
<meta name="theme-color" content="#f5f7f8" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:image" content={new URL(image, site.url).href} />
{image === "/images/og-default.jpg" && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate icon" href="/images/logo-source.png" type="image/png" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Le journal Aimy Digital"
  href="/feed.xml"
/>
<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replaceAll("<", "\u003c")}
/>
