---
interface Props {
  mode: "seo" | "ads";
}
const { mode } = Astro.props;
const labels =
  mode === "seo"
    ? ["La recherche", "La réponse", "Le choix", "Le contact"]
    : ["L’annonce", "La destination", "L’action", "La mesure"];
const titles =
  mode === "seo"
    ? [
        "Rénover à Cholet",
        "Une offre pertinente",
        "Un métier visible",
        "Ouvrir un échange",
      ]
    : [
        "Un besoin précis",
        "La même promesse",
        "Une demande claire",
        "Des signaux distincts",
      ];
---

<div
  class:list={["commercial-journey", `journey-${mode}`]}
  data-journey
  data-step="0"
>
  <div class="journey-heading">
    <span>Un même besoin, de bout en bout.</span>
    <span class="caption">Schéma illustratif · entreprise fictive</span>
  </div>
  <div class="journey-board">
    <div class="journey-wire" aria-hidden="true">
      <span></span>
    </div>
    <div class="journey-traveller" aria-hidden="true">
      Projet de rénovation ↗
    </div>
    {labels.map((label, i) => (
      <div class="journey-station" data-station>
        <span class="station-stop" aria-hidden="true">
          0{i + 1}
        </span>
        <button
          type="button"
          class="station-label"
          data-journey-select
          disabled
          aria-label={`Explorer : ${label}`}
        >
          {label} <span aria-hidden="true">↗</span>
        </button>
        <div class="station-interface" aria-hidden="true">
          {i === 0 && (
            <>
              <div class="interface-query">Rénovation · Cholet</div>
              <span class="interface-caption">
                {mode === "ads" ? "Annonce fictive" : "Réponse illustrative"}
              </span>
              <div class="interface-line long"></div>
              <div class="interface-line"></div>
              <div class="interface-link">Découvrir l’offre ↗</div>
            </>
          )}
          {i === 1 && (
            <>
              <div class="interface-browser">Une pièce à rénover ?</div>
              <div class="interface-layout">
                <span>Le métier</span>
                <span>Les travaux</span>
              </div>
              <div class="interface-line long"></div>
              <div class="interface-link">Présenter mon projet ↗</div>
            </>
          )}
          {i === 2 && (
            <>
              <div class="interface-browser">
                {mode === "seo"
                  ? "Comprendre avant de choisir"
                  : "Présenter mon projet"}
              </div>
              {mode === "seo" ? (
                <div class="interface-proof">
                  <span>Prestations</span>
                  <span>Réalisations</span>
                  <span>Zone d’intervention</span>
                </div>
              ) : (
                <div class="interface-fields">
                  <span>Votre besoin</span>
                  <span>Vos coordonnées</span>
                  <span>Votre message</span>
                </div>
              )}
            </>
          )}
          {i === 3 && (
            <>
              <div class="interface-browser">
                {mode === "seo"
                  ? "Parlons des travaux"
                  : "Observer sans confondre"}
              </div>
              <div class="interface-proof">
                {(mode === "seo"
                  ? ["Téléphone", "Formulaire", "Échange"]
                  : ["Clic", "Demande reçue", "Qualification"]
                ).map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </>
          )}
        </div>
        <strong>{titles[i]}</strong>
      </div>
    ))}
  </div>
  <p class="journey-foot">
    {mode === "seo"
      ? "La recherche reste le fil conducteur : une offre, des preuves, puis un moyen de joindre l’entreprise. Aucun classement Google reproduit."
      : "Le message traverse le parcours. La mesure distingue le clic, la demande effectivement reçue et sa qualification. Aucun envoi ni donnée de campagne."}
  </p>
</div>
<style>
  .commercial-journey {
    --ink: #10283e;
    --paper: #eef6fb;
    --line: #809cb0;
    background: var(--paper);
    color: var(--ink);
    padding: clamp(1rem, 3vw, 3rem);
    border: 1px solid #9bb7c9;
    position: relative;
    margin: 2rem 0;
  }
  .journey-ads {
    --paper: #10283e;
    --ink: #edf7ff;
    --line: #7393aa;
    border-color: #42657e;
  }
  .journey-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }
  .journey-heading > span:first-child {
    font-size: clamp(1.2rem, 2.1vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .journey-board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.6rem, 2vw, 2rem);
    padding-top: 2rem;
  }
  .journey-station {
    position: relative;
    min-width: 0;
    padding-top: 2rem;
  }
  .station-stop {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    text-align: center;
    line-height: 30px;
    font-size: 0.7rem;
    z-index: 1;
  }
  .journey-wire {
    position: absolute;
    height: 2px;
    background: var(--line);
    top: 47px;
    left: 16px;
    right: 16px;
    overflow: hidden;
  }
  .journey-wire span {
    display: block;
    height: 100%;
    background: #24a7ed;
    transform: scaleX(0);
    transform-origin: left;
  }
  .journey-traveller {
    position: absolute;
    top: 0;
    left: 0;
    background: #006397;
    color: white;
    border: 2px solid #c5eaff;
    box-shadow: 0 0 0 5px var(--paper);
    width: 172px;
    height: 32px;
    text-align: center;
    line-height: 28px;
    border-radius: 24px;
    z-index: 2;
    visibility: hidden;
    font-size: 0.7rem;
  }
  .station-label {
    background: transparent;
    color: inherit;
    border: 0;
    border-radius: 0;
    text-align: left;
    min-height: 48px;
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    padding: 1rem 0;
  }
  .journey-station strong {
    font-size: clamp(0.8rem, 1.3vw, 1rem);
    display: block;
    line-height: 1.4;
    min-height: 2.8em;
  }
  .station-interface {
    padding: 1rem;
    background: #fff;
    color: #10283e;
    border: 1px solid #8caaba;
    min-height: 195px;
    margin-bottom: 1rem;
    border-radius: 3px;
    transform-origin: 50% 100%;
    box-shadow: 0 8px 0 #7595aa20;
  }
  .journey-station[data-current="true"] .station-interface { border-color:#0570b0; box-shadow:0 8px 0 #0570b033; }
  .interface-query {
    border: 1px solid #94b3c6;
    border-radius: 30px;
    padding: 0.5rem;
    font-size: 0.7rem;
    margin-bottom: 0.8rem;
  }
  .interface-caption {
    font-size: 0.6rem;
    color: #38576c;
  }
  .interface-line {
    height: 5px;
    background: #b5cedc;
    width: 65%;
    margin: 10px 0;
  }
  .interface-line.long {
    width: 95%;
    background: #4d7e9b;
  }
  .interface-link {
    color: #005e92;
    font-size: 0.65rem;
    padding-top: 0.6rem;
    border-top: 1px solid #c6d9e5;
  }
  .interface-browser {
    font-size: 0.75rem;
    font-weight: 700;
    border-bottom: 1px solid #c6d9e5;
    padding-bottom: 0.7rem;
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }
  .interface-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }
  .interface-layout span {
    font-size: 0.65rem;
    background: #e6eff4;
    padding: 0.8rem 0.3rem;
  }
  .interface-proof,
  .interface-fields {
    display: grid;
    gap: 0.45rem;
    font-size: 0.65rem;
  }
  .interface-proof span {
    border-left: 2px solid #0570b0;
    padding: 0.25rem 0.5rem;
    background: #eaf3f8;
  }
  .interface-fields span {
    padding: 0.4rem;
    border: 1px solid #b5c9d5;
  }
  .journey-foot {
    font-size: 0.78rem !important;
    max-width: 90ch;
    line-height: 1.6;
    margin: 1.5rem 0 0 !important;
    color: inherit !important;
  }
  @media (max-width: 700px) {
    .journey-heading {
      display: block;
      margin-bottom: 1rem;
    }
    .journey-heading .caption {
      display: block;
      margin-top: 0.7rem;
    }
    .journey-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.3rem 1rem;
    }
    .station-interface {
      padding: 0.6rem;
      min-height: 185px;
    }
    .journey-wire {
      display: none;
    }
    .journey-traveller {
      width: 128px;
      font-size: 0.58rem;
    }
    .station-label {
      background: transparent;
      color: inherit;
      border: 0;
      border-radius: 0;
      text-align: left;
      min-height: 48px;
      cursor: pointer;
      width: 100%;
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
    }
    .interface-query {
      font-size: 0.6rem;
    }
    .journey-station strong {
      font-size: 0.8rem;
    }
  }
</style>
