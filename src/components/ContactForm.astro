---
const enabled = import.meta.env.PUBLIC_CONTACT_ENABLED === "true";
---

<form
  class="contact-form"
  action="/api/contact.php"
  method="post"
  data-enabled={enabled}
>
  <div class="field">
    <label for="name">Votre nom *</label>
    <input
      id="name"
      name="name"
      data-label="Nom"
      autocomplete="name"
      required
      minlength="2"
      maxlength="100"
    />
  </div>
  <div class="field">
    <label for="company">Votre entreprise</label>
    <input
      id="company"
      name="company"
      data-label="Entreprise"
      autocomplete="organization"
      maxlength="150"
    />
  </div>
  <div class="field">
    <label for="email">Votre e-mail *</label>
    <input
      id="email"
      name="email"
      data-label="E-mail"
      type="email"
      autocomplete="email"
      required
      maxlength="254"
    />
  </div>
  <div class="field">
    <label for="phone">Votre téléphone</label>
    <input
      id="phone"
      name="phone"
      data-label="Téléphone"
      type="tel"
      autocomplete="tel"
      maxlength="30"
    />
  </div>
  <fieldset class="project-picker full">
    <legend>Votre projet *</legend>
    <div>
      {[
        "Créer un site",
        "Refondre un site",
        "Créer une boutique",
        "Améliorer ma visibilité",
        "Maintenance et suivi",
        "Autre projet",
      ].map((need, i) => (
        <label>
          <input
            type="radio"
            name="need"
            value={need}
            data-label="Projet"
            required
          />
          <span>
            <span aria-hidden="true">0{i + 1}</span>
            {need}
            <span aria-hidden="true">↗</span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="field full">
    <label for="message">Parlez-nous de votre projet *</label>
    <textarea
      id="message"
      name="message"
      required
      minlength="20"
      maxlength="5000"
      placeholder="Votre activité, ce que vous souhaitez améliorer, votre calendrier…"
    ></textarea>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="website">Ne pas remplir</label>
    <input id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div class="form-foot">
    <p>
      AIMY DIGITAL, SASU, utilise vos coordonnées pour traiter votre demande et
      vous répondre. Les champs marqués * sont nécessaires ; les autres sont
      facultatifs.{" "}
      <a href="/politique-de-confidentialite/">Utilisation de vos données</a>.
    </p>
    {!enabled && (
      <p class="notice">
        À l’envoi, votre messagerie s’ouvre avec la demande déjà rédigée : il ne
        reste qu’à l’envoyer. Réponse et devis gratuit sous 24 h.
      </p>
    )}
    <button class="button" type="submit">
      Envoyer ma demande <span aria-hidden="true">↗</span>
    </button>
    <p
      class="form-status"
      role="status"
      hidden
      data-ok="Votre demande a été acceptée par le serveur de messagerie. Merci pour votre message."
      data-error="L’envoi n’a pas pu être confirmé. Vos informations restent dans le formulaire. Vous pouvez nous écrire à contact@aimy-digital.fr ou nous appeler."
    ></p>
    <p class="form-status form-mailto" role="status" hidden>
      Votre messagerie s’ouvre avec votre demande. Si rien ne s’affiche, écrivez
      à contact@aimy-digital.fr ou appelez le 06 52 59 77 80.
    </p>
    <noscript>
      <p>Vous pouvez nous écrire directement à contact@aimy-digital.fr.</p>
    </noscript>
  </div>
</form>
<script>
  import { track } from "../lib/analytics";
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  form
    ?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "input:not([type=radio]), textarea",
    )
    .forEach((field) => {
      if (field.name === "website") return;
      const hint = document.createElement("span");
      hint.className = "field-feedback";
      hint.id = `${field.id}-feedback`;
      hint.setAttribute("aria-live", "polite");
      field.after(hint);
      field.setAttribute("aria-describedby", hint.id);
      const validate = () => {
        field.setAttribute("aria-invalid", String(!field.validity.valid));
        hint.textContent = field.validity.valid
          ? ""
          : field.validity.valueMissing
            ? "Ce champ est nécessaire."
            : field.validity.typeMismatch
              ? "Indiquez une adresse e-mail valide."
              : field.validity.tooShort
                ? `Précisez votre réponse (${field.minLength} caractères minimum).`
                : "Vérifiez ce champ.";
      };
      field.addEventListener("blur", validate);
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true") validate();
      });
    });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const status = form.querySelector<HTMLParagraphElement>('[role="status"]')!;
    if (form.dataset.enabled !== "true") {
      // Sans envoi serveur configuré : la demande s'ouvre, rédigée, dans la messagerie.
      const body = [...new FormData(form)]
        .filter(([key, v]) => key !== "website" && v)
        .map(([key, v]) => {
          const label = form.querySelector<HTMLElement>(`[name=${key}]`)!
            .dataset.label;
          return label ? `${label} : ${v}` : `\n${v}`;
        })
        .join("\n");
      form.querySelector<HTMLElement>(".form-mailto")!.hidden = false;
      location.href = `mailto:contact@aimy-digital.fr?subject=Projet%20web&body=${encodeURIComponent(body)}`;
      return;
    }
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    button.disabled = true;
    status.hidden = false;
    status.textContent = "Envoi en cours…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        signal: AbortSignal.timeout(20000),
      });
      const result = await response.json();
      if (!response.ok || result.ok !== true) throw new Error();
      status.textContent = status.dataset.ok!;
      track("form_submit_success");
      form.reset();
    } catch {
      status.textContent = status.dataset.error!;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .project-picker {
    padding: 0;
    border: 0;
    margin: 0;
    min-width: 0;
  }
  .project-picker legend {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .project-picker > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .project-picker label {
    position: relative;
    cursor: pointer;
  }
  .project-picker input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .project-picker label > span {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.8rem;
    min-height: 64px;
    border: 1px solid #879fab;
    font-size: 0.8rem;
    line-height: 1.4;
    background: #fff;
  }
  .project-picker label > span > span:first-child {
    font-size: 0.65rem;
    color: #426174;
  }
  .project-picker input:checked + span {
    background: #123149;
    color: white;
    border-color: #123149;
  }
  .project-picker input:checked + span > span {
    color: white;
  }
  .project-picker input:focus-visible + span {
    outline: 3px solid #0078b5;
    outline-offset: 3px;
  }
  .field-feedback {
    font-size: 0.78rem;
    color: #9a241f;
    min-height: 1.2em;
  }
  .contact-form input[aria-invalid="true"],
  .contact-form textarea[aria-invalid="true"] {
    border-color: #9a241f;
  }
  @media (max-width: 400px) {
    .project-picker label > span {
      font-size: 0.72rem;
      padding: 0.75rem 0.5rem;
      gap: 0.4rem;
    }
    .project-picker label > span > span:first-child {
      display: none;
    }
  }
</style>
