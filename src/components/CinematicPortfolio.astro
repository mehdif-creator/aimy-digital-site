---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import games from "../../public/images/showcase/ht-crea-jeux.webp";
import nutri from "../../public/images/showcase/my-nutrizen.webp";
import sc from "../../public/images/showcase/sc-renovation.webp";
import lambert from "../../public/images/showcase/lambert-digital-pulse.webp";
import "../styles/cinematic-portfolio.css";
const cases = await getCollection("cases");
const chapters = [
  {
    slug: "ht-crea-jeux",
    image: games,
    word: "Jouer.",
    theme: "play",
    intent: "De la curiosité à la découverte des jeux.",
  },
  {
    slug: "my-nutrizen",
    image: nutri,
    word: "Simplifier.",
    theme: "nature",
    intent: "Des repas, des recettes, une organisation.",
  },
  {
    slug: "sc-renovation",
    image: sc,
    word: "Révéler.",
    theme: "craft",
    intent: "Du chantier à la demande de devis.",
  },
  {
    slug: "lambert-digital-pulse",
    image: lambert,
    word: "Rayonner.",
    theme: "pulse",
    intent: "Une personnalité, des services, une présence.",
  },
].map((chapter) => ({
  ...chapter,
  project: {
    ...cases.find((entry) => entry.data.path === chapter.slug)!.data,
    ...(chapter.slug === "lambert-digital-pulse"
      ? { website: "https://lambertdigitalpulse.fr/" }
      : {}),
  },
}));
---

<section class="showcase" id="realisations" aria-labelledby="showcase-title">
  <header class="showcase-intro container">
    <div>
      <p>Quatre projets. Quatre façons d’exister en ligne.</p>
      <h2 id="showcase-title">
        Le design prend
        <br />
        le parti de votre métier.
      </h2>
    </div>
    <div class="showcase-controls">
      <a href="#apres-realisations">Passer les projets ↓</a>
      <button type="button" data-showcase-toggle aria-pressed="false" hidden>
        Réduire les animations du portfolio
      </button>
    </div>
    <nav aria-label="Choisir une réalisation">
      {chapters.map(({ project, slug }, i) => (
        <a href={`#univers-${slug}`}>
          <span>0{i + 1}</span>
          {project.title}
        </a>
      ))}
    </nav>
  </header>
  {chapters.map(({ project, slug, image, word, theme, intent }, i) => (
    <article
      class={`showcase-chapter theme-${theme}`}
      id={`univers-${slug}`}
      aria-labelledby={`title-${slug}`}
    >
      <div class="showcase-stage">
        <div class="showcase-orbit" aria-hidden="true"></div>
        <svg
          class="showcase-word"
          viewBox="0 0 1500 280"
          aria-hidden="true"
          focusable="false"
        >
          <text x="0" y="235">
            {word}
          </text>
        </svg>
        <div class="showcase-top">
          <span>0{i + 1} / 04</span>
          <span>{project.category}</span>
        </div>
        <div class="showcase-copy">
          <h3 id={`title-${slug}`}>{project.title}</h3>
          <p>{project.description}</p>
          <p class="showcase-intent">{intent}</p>
          <a class="showcase-project-link" href={`/portfolio/${slug}/`}>
            Découvrir le projet <span aria-hidden="true">↗</span>
          </a>
          <a
            class="showcase-live-link"
            href={project.website}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visiter le site <span class="sr-only">(nouvel onglet)</span>↗
          </a>
        </div>
        <figure class="showcase-composition">
          <div class="showcase-desktop">
            <div class="showcase-browser" aria-hidden="true">
              <span>● ● ●</span>
              <span>{new URL(project.website).hostname}</span>
            </div>
            <div class="showcase-viewport">
              <Image
                src={image}
                width={1440}
                widths={[480, 800, 1200, 1600, 1920, 2400, 2880].filter(
                  (w) => w <= image.width,
                )}
                sizes="(max-width: 759px) 88vw, (min-width: 2000px) 1140px, 57vw"
                quality={90}
                loading="lazy"
                decoding="async"
                alt={`Capture réelle du site ${project.title}`}
              />
            </div>
          </div>
          {slug === "sc-renovation" && (
            <div class="showcase-mobile">
              <img
                src="/images/hero/sc-renovation-mobile.webp"
                width="390"
                height="844"
                loading="lazy"
                decoding="async"
                alt="SC Rénovation sur mobile : accès au devis et à l’appel"
              />
            </div>
          )}
          <figcaption>{project.mission}</figcaption>
        </figure>
        <div class="showcase-bottom">
          <span>
            {i === 0
              ? "Découvrir"
              : i === 1
                ? "Organiser"
                : i === 2
                  ? "Présenter"
                  : "Affirmer"}
          </span>
          <div class="showcase-progress" aria-hidden="true">
            <i></i>
          </div>
          <a
            href={
              i < 3 ? `#univers-${chapters[i + 1].slug}` : "#apres-realisations"
            }
          >
            {i < 3 ? "Projet suivant" : "La suite"} ↓
          </a>
        </div>
      </div>
    </article>
  ))}
  <div class="showcase-outro container">
    <p>
      Votre métier a aussi
      <br />
      son histoire à raconter.
    </p>
    <a href="/contact/">Parlons de votre projet ↗</a>
  </div>
</section>
<script>
  import { initCinematicPortfolio } from "../lib/cinematic-portfolio";
  initCinematicPortfolio();
</script>
