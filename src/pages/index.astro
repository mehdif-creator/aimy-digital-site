---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import HomeExperience from "../components/HomeExperience.astro";

import CinematicHero from "../components/CinematicHero.astro";
import TrustSection from "../components/TrustSection.astro";
import BocageMap from "../components/BocageMap.astro";
import Reviews from "../components/Reviews.astro";
import { questions } from "../lib/site";
---

<BaseLayout
  title="Création de sites web et SEO local à Mauléon"
  description="Aimy Digital conçoit des sites internet pour artisans et PME à Mauléon, Cholet, Bressuire et Les Herbiers. Design, clarté et visibilité locale."
  cinematicHero
  faq={questions}
>
  <CinematicHero />
  <div class="home-proof">
    <div class="container region-band">
      <span>Ancrés près de chez vous.</span>
      <a href="/creation-site-internet-mauleon/">Mauléon</a>
      <a href="/creation-site-internet-cholet/">Cholet</a>
      <a href="/creation-site-internet-bressuire/">Bressuire</a>
      <a href="/creation-site-internet-les-herbiers/">Les Herbiers</a>
    </div>
    <ProjectPreview />
    <TrustSection />
  </div>
  <Reviews />
  <BocageMap />
  <HomeExperience />
</BaseLayout>
