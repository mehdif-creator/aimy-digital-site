---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import { services, type Service } from "../lib/site";
import type { CollectionEntry } from "astro:content";
export async function getStaticPaths() {
  return [
    ...services
      .filter(
        (service) =>
          ![
            "creation-de-sites-internet",
            "referencement-seo",
            "publicites-sea",
            "maintenance-et-securite",
          ].includes(service.path),
      )
      .map((service) => ({
        params: { path: service.path },
        props: { service, post: undefined },
      })),
    ...(await getCollection("posts")).map((post) => ({
      params: { path: post.data.path },
      props: { post, service: undefined },
    })),
  ];
}
const { service, post } = Astro.props as {
  service?: Service;
  post?: CollectionEntry<"posts">;
};
const title = service?.title || post!.data.title;
// Prestation liée à l'article, d'après sa catégorie principale.
const related = post
  ? post.data.categories.includes(4)
    ? { href: "/referencement-seo/", label: "le référencement SEO local" }
    : post.data.categories.includes(30)
      ? { href: "/maintenance-et-securite/", label: "la maintenance de site" }
      : post.data.categories.includes(1)
        ? { href: "/publicites-sea/", label: "la publicité Google et Meta" }
        : {
            href: "/creation-de-sites-internet/",
            label: "la création de sites internet",
          }
  : undefined;
const description = service?.description || post!.data.description;
---

<BaseLayout
  title={post?.data.seoTitle || title}
  description={description}
  image={post?.data.image}
  article={
    post ? { date: post.data.date, modified: post.data.modified } : undefined
  }
>
  <div class="container">
    <header class="page-intro">
      <p class="breadcrumb">
        <a href="/">Accueil</a> /{" "}
        <a href={post ? "/blog/" : "/nos-prestations/"}>
          {post ? "Le journal" : "Prestations"}
        </a>{" "}
        / {title}
      </p>
      <h1>{service?.headline || title}</h1>
      {service && (
        <>
          <p class="lead">{service.intro}</p>
          <Button href="/contact/">Parler de mon projet</Button>
        </>
      )}
    </header>
    {service ? (
      <>
        <section class="content-grid section">
          <div>
            <h2>Un projet adapté à votre situation.</h2>
            <p class="lead">{service.audience}</p>
            <h3>Ce que nous cadrons avec vous</h3>
            <ul class="checklist">
              {service.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <aside class="content-panel">
            <h2>Comment avancer</h2>
            <ol class="steps">
              {service.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </aside>
        </section>
        <section class="section">
          <h2>Vos questions, avant de décider.</h2>
          <FAQ />
          <nav class="subnav" aria-label="Autres prestations">
            {services
              .filter((s) => s.path !== service.path)
              .map((s) => (
                <a href={`/${s.path}/`}>{s.title}</a>
              ))}
          </nav>
        </section>
      </>
    ) : (
      post && (
        <article class="prose section">
          <p class="article-meta">
            Publié le{" "}
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString("fr-FR")}
            </time>
          </p>
          {post.data.historicalReview && (
            <aside
              class="article-history"
              aria-label="Contexte de cette archive"
            >
              <p>
                <strong>Article publié en 2025.</strong>
              </p>
              <p>
                Les tarifs, statistiques et outils cités datent de sa
                publication et peuvent avoir évolué. Ils ne constituent pas les
                offres actuelles d’Aimy Digital.
              </p>
              <p>
                Pour le périmètre actuel :{" "}
                <a href="/nos-prestations/">consultez nos prestations</a> ou{" "}
                <a href="/contact/">contactez-nous</a>.
              </p>
            </aside>
          )}
          <div set:html={post.data.html} />
          <aside class="article-next" aria-label="Passer à l’action">
            <p class="article-next-kicker">Et pour votre entreprise ?</p>
            <p class="article-next-title">
              Aimy Digital vous accompagne sur {related!.label}, à Mauléon,
              Cholet, Bressuire et Les Herbiers.
            </p>
            <div>
              <a class="article-next-cta" href="/contact/">
                Devis gratuit sous 24 h ↗
              </a>
              <a href={related!.href}>Découvrir la prestation</a>
            </div>
          </aside>
          <p>
            <a href="/blog/">Tous les articles</a>
          </p>
        </article>
      )
    )}
  </div>
  <CTA />
</BaseLayout>

<style>
  .article-history {
    border-left: 3px solid var(--blue, #1765ed);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    background: #edf4fa;
    color: #142638;
  }
  .article-history p {
    margin: 0 0 0.75rem;
  }
  .article-history p:last-child {
    margin-bottom: 0;
  }
  .prose {
    overflow-wrap: anywhere;
  }
  .article-next {
    margin: 3.5rem 0 2rem;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: 1.4rem;
    background: #071726;
    color: #edf6ff;
  }
  .article-next p {
    margin: 0;
  }
  .article-next-kicker {
    font-size: 0.8rem;
    color: #9bb5ce;
  }
  .article-next-title {
    margin: 0.6rem 0 1.6rem !important;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .article-next div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    align-items: center;
  }
  .article-next a {
    color: #edf6ff;
    font-weight: 700;
  }
  .article-next-cta {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    padding: 0 1.4rem;
    border-radius: 100px;
    background: #0670ad;
    color: #fff !important;
    text-decoration: none;
  }
</style>
