---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommercialInteractions from "../../components/CommercialInteractions.astro";
import categories from "../../data/categories.json";
import "../../styles/commercial-premium.css";
const images = import.meta.glob<ImageMetadata>(
  "../../../public/wp-content/uploads/**/*.{png,jpg,jpeg,webp}",
  { eager: true, import: "default" },
);
const posts = (await getCollection("posts")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const active = categories.filter((c) =>
  posts.some((p) => p.data.categories.includes(c.id)),
);
const service = (id: number) =>
  id === 4
    ? "/referencement-seo/"
    : id === 30
      ? "/maintenance-et-securite/"
      : id === 1
        ? "/publicites-sea/"
        : "/creation-de-sites-internet/";
---

<BaseLayout
  title="Le journal Aimy Digital : web, SEO et stratégie digitale"
  description="Des lectures pour éclairer vos choix : création de sites internet, référencement local, publicité, maintenance et outils numériques pour votre entreprise."
>
  <div class="premium journal-page" data-filter>
    <header class="hero wrap">
      <span class="eyebrow">Le journal Aimy Digital</span>
      <div class="journal-masthead">
        <h1><span class="h1-kicker">Blog : conseils web, SEO et stratégie digitale</span>
          Prendre
          <br />
          <em>du recul.</em>
        </h1>
        <p class="intro">
          Le web change.
          <br />
          Les bonnes questions restent.
          <br />
          Des lectures pour décider avec plus de clarté.
        </p>
      </div>
      <div class="journal-line">
        <span>WEB · VISIBILITÉ · ENTREPRISE</span>
        <span>{posts.length} articles</span>
      </div>
    </header>
    <section class="wrap journal-content" aria-label="Articles">
      <div data-filter-controls>
        <div class="filters">
          <button type="button" data-category="all">
            Toutes les lectures
          </button>
          {active.map((c) => (
            <button type="button" data-category={String(c.id)}>
              {c.name}
            </button>
          ))}
        </div>
        <p
          data-count
          class="filter-status"
          role="status"
          aria-live="polite"
        ></p>
      </div>
      <div class="magazine">
        {posts.map(({ data }, i) => {
          const category = categories.find((c) => c.id === data.categories[0]);
          const cover = data.image
            ? images["../../../public" + data.image]
            : undefined;
          return (
            <article
              data-item={data.categories.join("|")}
              class:list={["magazine-article", { featured: i === 0 }]}
            >
              <a
                class="article-cover"
                style={cover ? `max-width:${cover.width}px` : undefined}
                href={`/${data.path}/`}
                tabindex="-1"
                aria-hidden="true"
              >
                {cover ? (
                  <Image
                    src={cover}
                    alt=""
                    widths={[320, 540, 768, 1024].filter(
                      (w) => w <= cover.width,
                    )}
                    sizes="(max-width: 550px) 92vw, (max-width: 850px) 48vw, 55vw"
                    format="webp"
                    quality={88}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                ) : (
                  <span class="cover-type">
                    {category?.name || "Le journal"}
                  </span>
                )}
                <span class="cover-label">
                  {i === 0 ? "À LA UNE" : "LECTURE"} <span>↗</span>
                </span>
              </a>
              <div class="article-copy">
                <span class="eyebrow">
                  {category?.name || "Stratégie digitale"}
                </span>
                <h2>
                  <a href={`/${data.path}/`}>{data.title}</a>
                </h2>
                <time datetime={data.date}>
                  {new Date(data.date).toLocaleDateString("fr-FR", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </time>
                {(data.path.includes("2025") ||
                  data.title.includes("2025")) && (
                  <p class="archive-note">
                    Repères de 2025 · à lire dans leur contexte de publication.
                  </p>
                )}
                <div class="article-bottom">
                  <a href={`/${data.path}/`}>Lire l’article ↗</a>
                  <a href={service(data.categories[0])}>
                    La prestation associée
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
    <section class="closing">
      <div class="wrap">
        <div>
          <span class="eyebrow">De la lecture au projet</span>
          <h2>Appliquons ces questions à votre activité.</h2>
        </div>
        <a class="action" href="/contact/">
          Échanger sur mon projet ↗
        </a>
      </div>
    </section>
  </div>
  <CommercialInteractions />
  <noscript>
    <style>
      .premium [data-filter-controls] {
        display: none !important;
      }
    </style>
  </noscript>
</BaseLayout>
<style>
  .journal-page {
    background: #f0efeb;
  }
  .journal-masthead {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
  }
  .journal-page h1 {
    font-size: clamp(4rem, 9vw, 9rem);
    max-width: 12ch;
    margin-bottom: 0;
  }
  .journal-page em {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.065em;
    color: #245e7d;
  }
  .journal-masthead .intro {
    max-width: 28ch;
    margin-bottom: 0.7rem;
  }
  .journal-line {
    border-block: 1px solid #a8b3b8;
    margin-top: 3rem;
    padding: 1rem 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }
  .journal-content {
    padding-bottom: 5rem;
  }
  .magazine {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4rem 2rem;
  }
  .magazine-article {
    grid-column: span 3;
    min-width: 0;
  }
  .magazine-article.featured {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .magazine-article:nth-child(3n + 2) {
    grid-column: span 4;
  }
  .magazine-article:nth-child(3n + 3) {
    grid-column: span 2;
  }
  .article-cover {
    display: block;
    position: relative;
    aspect-ratio: 1.7;
    overflow: hidden;
    background: #d5e2e8;
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding-bottom: 2.6rem;
    transition: transform 0.45s;
  }
  .archive-note {
    font-size: 0.78rem;
    color: #405a6a;
    margin-top: 0.7rem;
  }
  .cover-type {
    font-size: 3rem;
    padding: 2rem;
    display: block;
  }
  .cover-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #102639;
    color: white;
    padding: 0.8rem 1rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    display: flex;
    justify-content: space-between;
  }
  .article-copy {
    padding-top: 1.5rem;
  }
  .article-copy h2 {
    font-size: clamp(1.6rem, 2.3vw, 2.4rem);
    max-width: none;
  }
  .featured h2 {
    font-size: clamp(2rem, 3.5vw, 3.3rem);
  }
  .article-copy .eyebrow {
    font-size: 0.65rem;
    margin-bottom: 0.8rem;
  }
  .article-copy time {
    font-size: 0.8rem;
    color: #405a6a;
  }
  .article-bottom {
    border-top: 1px solid #a8b3b8;
    margin-top: 1.5rem;
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    font-size: 0.75rem;
  }
  .article-bottom a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 850px) {
    .journal-masthead {
      display: block;
    }
    .journal-masthead .intro {
      margin-top: 2rem;
    }
    .magazine {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 1.5rem;
    }
    .magazine-article.featured {
      display: block;
    }
    .magazine-article,
    .magazine-article:nth-child(3n + 2),
    .magazine-article:nth-child(3n + 3) {
      grid-column: span 1;
    }
    .magazine-article.featured {
      grid-column: 1/-1;
    }
  }
  @media (max-width: 550px) {
    .magazine {
      display: block;
    }
    .magazine-article {
      margin-bottom: 3rem;
    }
    .journal-line {
      font-size: 0.6rem;
    }
    .journal-page .filters button {
      font-size: 0.75rem;
    }
  }
</style>
