---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HtCaseStudy from "../../components/HtCaseStudy.astro";
const { data } = (await getCollection("cases")).find(
  (project) => project.data.path === "ht-crea-jeux",
)!;
---

<BaseLayout
  title={`${data.title} : ${data.category.toLowerCase()}, réalisation web`}
  description={`${data.description} Une réalisation Aimy Digital, agence web près de Mauléon.`}
  image={data.image}
>
  <HtCaseStudy />
</BaseLayout>
