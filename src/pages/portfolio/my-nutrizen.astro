---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NutrizenCaseStudy from "../../components/NutrizenCaseStudy.astro";
const { data } = (await getCollection("cases")).find(
  (project) => project.data.path === "my-nutrizen",
)!;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
>
  <NutrizenCaseStudy />
</BaseLayout>
