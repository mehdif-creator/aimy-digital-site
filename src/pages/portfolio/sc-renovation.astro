---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScCaseStudy from "../../components/ScCaseStudy.astro";
const { data } = (await getCollection("cases")).find(
  (p) => p.data.path === "sc-renovation",
)!;
---

<BaseLayout
  title={`${data.title} : ${data.category.toLowerCase()}, réalisation web`}
  description={`${data.description} Une réalisation Aimy Digital, agence web près de Mauléon.`}
  image={data.image}
>
  <ScCaseStudy />
</BaseLayout>
