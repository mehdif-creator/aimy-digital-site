---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScCaseStudy from '../../components/ScCaseStudy.astro';
const {data}=(await getCollection('cases')).find(p=>p.data.path==='sc-renovation')!;
