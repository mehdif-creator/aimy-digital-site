---
import { getCollection } from "astro:content";
import categories from "../../data/categories.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const posts = (await getCollection("posts")).filter((post) =>
  post.data.categories.includes(category.id),
);
---

<BaseLayout
  title={category.name}
  description={`Les articles Aimy Digital de la rubrique ${category.name}.`}
  noindex={posts.length === 0}
>
  <section class="container section">
    <p class="breadcrumb">
      <a href="/blog/">Le journal</a> / {category.name}
    </p>
    <h1>{category.name}</h1>
    {posts.length > 0 ? (
      <div class="blog-grid">
        {posts.map(({ data }) => (
          <article class="article-card">
            <h2>
              <a href={`/${data.path}/`}>{data.title}</a>
            </h2>
            <p>{data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>
        Aucun article dans cette rubrique. Retrouvez{" "}
        <a class="text-link" href="/blog/">
          tous nos articles
        </a>
        .
      </p>
    )}
  </section>
</BaseLayout>
