{
  "name": "aimy-digital-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/content.test.mjs tests/portfolio.test.mjs tests/regressions.test.mjs tests/restoration.test.mjs tests/htaccess.test.mjs",
    "audit": "node scripts/check-build.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs",
    "format:check": "prettier --check src scripts tests astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "gsap": "3.15.0",
    "sanitize-html": "2.18.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
